# Runtime Data — ignore local developer copies of these auto-generated files
data/runtime_state.json
data/sim_intensity.json

# Keep the data directory itself tracked
!data/.gitkeep

# runs.csv is intentionally NOT ignored here.
# The GreenOps CI bot commits it after each green/amber pipeline run
# so the repo accumulates a full emissions audit log.
# Git will track it normally; the venv and local dev workflow never write to it.

